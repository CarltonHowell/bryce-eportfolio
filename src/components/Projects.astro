---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import Rule from './Rule.astro';
import Wave from './Wave.astro';
import Arrow from './Arrow.astro';

const projects = (await getCollection('work', (e) => e.data.listed)).sort((a, b) => a.data.order - b.data.order);
const btn =
  'group/btn items-center gap-3 border px-[calc(15*var(--px))] py-[calc(9*var(--px))] [@media(pointer:coarse)]:min-h-[calc(48*var(--px))] text-body font-medium leading-[1.5] transition-[background-color,color,border-color] duration-300 ease-out-soft inline-flex shrink-0 [--hw-base:#0A0A0A] hover:border-ink hover:bg-ink hover:text-white';
const chip =
  'border border-white/20 bg-[var(--night-chip)] p-[calc(9*var(--px))] text-label capitalize leading-none tracking-[calc(-0.2*var(--px))] text-white';
---

<section id="projects" class="relative flex min-h-[100svh] w-full flex-col justify-center bg-canvas py-16 lg:pt-32 lg:pb-[calc(164*var(--px))]">
  <Container>
    <div><h2 class="text-section font-medium text-ink">Selected Work</h2></div>
    <Rule class="mt-8 lg:mt-[calc(32*var(--px))]" />
    <ul class="lg:flex lg:h-[calc(718*var(--px))] lg:flex-col" data-projects>
      {
        projects.map((p, i) => (
          <li class="project lg:relative lg:flex lg:flex-1 lg:flex-col lg:overflow-hidden" data-project data-active={i === 0 ? '' : undefined}>
            <a href={`#work/${p.id}`} data-open-work={p.id} class="group block py-8 lg:py-[calc(24*var(--px))]" aria-label={`${p.data.name} - ${p.data.category}`}>
              <div class="grid grid-cols-1 items-start lg:grid-cols-[1fr_calc(330*var(--px))] lg:gap-x-10">
                <div class="min-w-0">
                  <div class="flex flex-col items-start gap-y-4 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between lg:gap-x-6">
                    <h3 class="project-title text-project font-medium transition-colors duration-300 [--hw-base:#0A0A0A]" data-hw data-hw-on={i === 0 ? '' : undefined}>
                      <Wave text={p.data.name} />
                    </h3>
                    <span class:list={[btn, 'project-btn']} data-hw>
                      <Wave text="Open Project" />
                      <Arrow />
                    </span>
                  </div>
                </div>
                <div class="project-cover transition-opacity duration-500 ease-out-soft motion-reduce:transition-none lg:col-start-2">
                  <div class="group/cover relative mt-6 aspect-[16/10] w-full overflow-hidden lg:mt-0 lg:aspect-[3/2] lg:w-[calc(330*var(--px))]" data-hw-appear>
                    <Image src={p.data.cover} alt={`${p.data.name} - ${p.data.category}`} widths={[480, 800]} sizes="(min-width: 1024px) 330px, 100vw" class="absolute inset-0 h-full w-full object-cover" />
                    <div
                      class="absolute inset-0 hidden flex-col justify-end opacity-0 transition-opacity duration-300 ease-out-soft group-hover/cover:opacity-100 lg:flex"
                      style="background-image:linear-gradient(180deg, rgba(4,4,4,0) 19%, rgba(4,4,4,0.94) 100%)"
                    >
                      <div class="flex translate-y-1.5 flex-wrap gap-[calc(7*var(--px))] p-[calc(14*var(--px))] transition-transform duration-300 ease-out-soft group-hover/cover:translate-y-0">
                        <span class={chip}>
                          <Wave text={p.data.name} />
                        </span>
                        <span class:list={[chip, 'max-w-full truncate']}>
                          <Wave text={p.data.meta[0].value} />
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <dl
                aria-hidden="true"
                data-hw-appear
                data-hw-on={i === 0 ? '' : undefined}
                class="project-meta hidden lg:absolute lg:bottom-[calc(24*var(--px))] lg:left-0 lg:flex lg:max-w-[calc(100%-calc(390*var(--px)))] lg:flex-wrap lg:gap-x-12 lg:gap-y-2 lg:transition-[opacity,transform] lg:duration-500 lg:ease-out-soft motion-reduce:lg:transition-none"
              >
                {
                  p.data.meta.map((m) => (
                    <div>
                      <dt class="text-label text-muted">
                        <Wave text={m.label} />
                      </dt>
                      <dd class="mt-1 text-body text-ink">
                        <Wave text={m.value} />
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </a>
            <div class="h-[1.5px] w-full bg-rule lg:absolute lg:inset-x-0 lg:bottom-0" aria-hidden="true" />
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .project-title {
    color: var(--color-ink);
  }
  .project-btn {
    border-color: rgb(10 10 10 / 0.25);
    color: var(--color-ink);
  }
  [data-active] .project-title {
    color: var(--color-accent);
  }
  [data-active] .project-btn {
    border-color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .project {
      min-height: calc(112 * var(--px));
      transition: min-height 500ms var(--ease-out-soft);
    }
    .project[data-active] {
      min-height: calc(270 * var(--px));
    }
    .project:not([data-active]) .project-title,
    .project:not([data-active]) .project-btn {
      opacity: 0.45;
    }
    .project:not([data-active]) .project-cover {
      opacity: 0;
    }
    .project-meta {
      opacity: 1;
      transform: none;
    }
    .project:not([data-active]) .project-meta {
      opacity: 0;
      transform: translateY(0.375rem);
      pointer-events: none;
    }
  }
</style>
